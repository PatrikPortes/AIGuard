# .env is not automatically loaded. Use Node --env-file=.env (server only).
PORT=3000
HOST=127.0.0.1
GUARD_CLIENT_IP_MODE=socket
# cloudflare mode accepts CF-Connecting-IP only from this exact socket peer.
GUARD_TRUSTED_PROXY_IP=
AI_MODE=rules
GUARD_GLOBAL_API_RATE_LIMIT=600
GUARD_MAX_ACTIVE_REQUESTS=64
GUARD_MAX_CONCURRENT_ANALYSES=8
# Production additionally requires GUARD_PUBLIC_ORIGIN=https://verimtomu.fyi.
# Local development must leave GUARD_PUBLIC_ORIGIN unset (HTTP loopback).
# Set AI_MODE=ai only after filling credentials, verified model/prices and budgets.
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL_SIMPLE=gpt-4o-mini
AI_MODEL_COMPLEX=gpt-4o-mini
GUARD_LLM_API_KEY=
# Fill current verified upper-bound USD / 1 million tokens across BOTH models.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Safe default: no AI spending until operator explicitly permits it.
AI_DAILY_REQUEST_LIMIT=0
AI_DAILY_BUDGET_MICRO_USD=0
AI_TOTAL_BUDGET_MICRO_USD=0
AI_BUDGET_DB=data/ai-budget.sqlite
AI_DEPLOYMENT_MODE=single-host
AI_MAX_INPUT_TOKENS=24000
AI_MAX_OUTPUT_TOKENS=1400
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=0
AI_CRITIC_ENABLED=false
AI_QUEUE_CAPACITY=20
AI_WORKER_CONCURRENCY=2
AI_ALLOW_LOCAL=false
GUARD_IP_RATE_LIMIT=20
GUARD_SESSION_RATE_LIMIT=10
GUARD_COOKIE_SECURE=false
# true requires injected server-side botVerifier, currently no CAPTCHA integration.
GUARD_REQUIRE_BOT_CHECK=false
