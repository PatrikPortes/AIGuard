AI_MODE=ai
AI_BETA_ENABLED=true
AI_DAILY_REQUEST_LIMIT=1000
AI_DAILY_BUDGET_MICRO_USD=5000000
AI_TOTAL_BUDGET_MICRO_USD=1000000000000
AI_ENDPOINT=http://172.30.41.3:8080/v1/chat/completions
AI_INTERNAL_PROXY=true
AI_MODEL_SIMPLE=gpt-4.1-mini-2025-04-14
AI_MODEL_COMPLEX=gpt-4.1-mini-2025-04-14
