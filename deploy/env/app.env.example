NODE_ENV=production
# Bind inside the private internal network; no host port is published.
HOST=0.0.0.0
PORT=3000
AI_MODE=rules
GUARD_CLIENT_IP_MODE=cloudflare
# GUARD_TRUSTED_PROXY_IP is supplied by Compose, not by public requests.
GUARD_COOKIE_SECURE=true
GUARD_IP_RATE_LIMIT=20
GUARD_SESSION_RATE_LIMIT=10
GUARD_SESSION_ISSUE_RATE_LIMIT=10
GUARD_MAX_BODY_REQUESTS_PER_CLIENT=2
GUARD_MAX_ANALYSES_PER_CLIENT=2
GUARD_STATIC_RATE_LIMIT=120
GUARD_STATIC_BYTES_PER_MINUTE=2097152
GUARD_PUBLIC_ORIGIN=https://verimtomu.fyi
GUARD_GLOBAL_API_RATE_LIMIT=600
GUARD_MAX_ACTIVE_REQUESTS=64
GUARD_MAX_CONCURRENT_ANALYSES=8
GUARD_REQUIRE_BOT_CHECK=false
AI_DAILY_REQUEST_LIMIT=0
AI_DAILY_BUDGET_MICRO_USD=0
AI_TOTAL_BUDGET_MICRO_USD=0
AI_CRITIC_ENABLED=false
AI_MAX_RETRIES=0
AI_ALLOW_LOCAL=false
